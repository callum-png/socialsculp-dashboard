<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>ai.openclaw.command-poller</string>

    <key>Comment</key>
    <string>OpenClaw Command Poller — executes remote commands from SocialSculp dashboard</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/callumhyman/socialsculp-dashboard/scripts/openclaw-command-poller.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>5</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/callumhyman/.openclaw/logs/command-poller.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/callumhyman/.openclaw/logs/command-poller.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>/Users/callumhyman</string>
      <key>OPENCLAW_HOME</key>
      <string>/Users/callumhyman/.openclaw</string>
      <key>PATH</key>
      <string>/Users/callumhyman/.nvm/versions/node/v24.13.1/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
  </dict>
</plist>
