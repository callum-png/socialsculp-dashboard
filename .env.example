# ─────────────────────────────────────────────────────────────────────────────
# SocialSculp Dashboard — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────

# The public URL of your deployed app (used for metadata and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Clerk (Authentication) ────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your application → API Keys

# Public key (safe to expose to the browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key (server-side only — NEVER expose to the browser)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret for Clerk webhooks (used in /api/webhooks/clerk)
# Get this from Clerk Dashboard → Webhooks → your endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Custom sign-in / sign-up URLs (optional — Clerk defaults work fine)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── Database (PostgreSQL via Prisma) ──────────────────────────────────────────
# Supabase, Neon, PlanetScale, Railway, etc.

# Pooled connection URL (used by Prisma Client at runtime)
# For Supabase: Settings → Database → Connection string → Transaction mode
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[HOST]:[PORT]/[DATABASE]?pgbouncer=true&connection_limit=1

# Direct (non-pooled) connection URL (used by Prisma migrations)
# For Supabase: Settings → Database → Connection string → Session mode
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@[HOST]:[PORT]/[DATABASE]

# ── Platform Data Source ──────────────────────────────────────────────────────
# Controls whether the app uses real platform APIs or generated mock data.
#
# Options:
#   mock  — use MockAdapter (no API keys needed, works offline) [default]
#   live  — use real TikTok / Instagram APIs (requires API credentials below)
PLATFORM_DATA_SOURCE=mock

# ── TikTok API (optional — only needed when PLATFORM_DATA_SOURCE=live) ────────
# Apply at: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── Instagram / Meta API (optional — only needed when PLATFORM_DATA_SOURCE=live)
# Apply at: https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── Uploadthing (file uploads — media kits, briefs, contracts) ────────────────
# Get from https://uploadthing.com/dashboard
UPLOADTHING_SECRET=your_uploadthing_secret_key_here
UPLOADTHING_APP_ID=xxxxxxxxxxxx

# ── Resend (transactional email) ──────────────────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Analytics (optional) ─────────────────────────────────────────────────────
# Vercel Analytics is enabled automatically on Vercel deployments.
# Add Posthog, Mixpanel, etc. keys here if needed.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
