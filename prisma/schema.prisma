// ─── Datasource ───────────────────────────────────────────────────────────────
// Connection URLs are configured in prisma.config.ts (Prisma v7+).

datasource db {
  provider = "postgresql"
}

// ─── Generator ────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  AGENT
  CREATOR
  BRAND
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum Platform {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  BOTH
}

enum DealStage {
  OUTREACH
  NEGOTIATING
  SIGNED
  LIVE
  COMPLETED
  CANCELLED
}

enum ContentType {
  REEL
  TIKTOK_VIDEO
  STORY
  POST
  CAROUSEL
  YOUTUBE_SHORT
}

enum SalesDealStage {
  APPOINTMENT_SET
  QUALIFIED
  DECISION_MAKER
  PROPOSAL_SENT
  CLOSED_WON
  CLOSED_LOST
}

enum LeadType {
  BRAND
  CREATOR
}

// ─── Models ───────────────────────────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model AdminTask {
  id          String        @id @default(cuid())
  title       String
  notes       String?
  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)
  campaignId  String?
  campaign    Campaign?     @relation(fields: [campaignId], references: [id])
  assigneeId  String?
  assignee    User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  createdById String
  createdBy   User          @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  role      UserRole
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatorProfile CreatorProfile?
  brandProfile   BrandProfile?
  leads            Lead[]
  salesDeals       SalesDeal[]
  callPreps        CallPrep[]
  submittedPosts   Post[]
  publishedReports CampaignReport[]
  tasksCreated     AdminTask[] @relation("TaskCreator")
  tasksAssigned    AdminTask[] @relation("TaskAssignee")

  @@map("users")
}

model CreatorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  handle       String  @unique
  bio          String?
  niche        String[]
  location     String?
  mediaKitUrl  String?

  // TikTok stats
  tiktokFollowers Int?
  tiktokAvgViews  Int?
  tiktokEngRate   Float?

  // Instagram stats
  instagramFollowers Int?
  instagramAvgLikes  Int?
  instagramEngRate   Float?

  // Aggregate stats
  totalReach     Int   @default(0)
  avgEngagement  Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals             Deal[]
  campaignCreators  CampaignCreator[]
  platformStats     PlatformStat[]

  @@map("creator_profiles")
}

model BrandProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  industry    String?
  logoUrl     String?
  website     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]

  @@map("brand_profiles")
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)
  platform    Platform
  contentTypes ContentType[]

  totalBudget  Float
  spentBudget  Float @default(0)

  startDate DateTime?
  endDate   DateTime?

  targetReach       Int?
  targetEngagement  Float?
  targetROAS        Float?

  brandId String
  brand   BrandProfile @relation(fields: [brandId], references: [id], onDelete: Restrict)

  tags       String[]
  briefUrl   String?
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals               Deal[]
  campaignCreators    CampaignCreator[]
  analyticsSnapshots  AnalyticsSnapshot[]
  posts               Post[]
  campaignReports     CampaignReport[]
  adminTasks          AdminTask[]

  @@map("campaigns")
}

model CampaignCreator {
  id         String @id @default(cuid())
  campaignId String
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  role  String?
  fee   Float?
  notes String?

  @@unique([campaignId, creatorId])
  @@map("campaign_creators")
}

model Deal {
  id    String    @id @default(cuid())
  title String
  stage DealStage @default(OUTREACH)

  proposedFee Float?
  agreedFee   Float?
  currency    String @default("USD")

  campaignId String
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  creatorId  String
  creator    CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  outreachDate   DateTime?
  signedDate     DateTime?
  liveDate       DateTime?
  completedDate  DateTime?

  notes       String?
  contractUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliverables  Deliverable[]
  stageHistory  DealStageEvent[]

  @@map("deals")
}

model Deliverable {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  platform    Platform
  contentType ContentType

  dueDate   DateTime?
  submitted Boolean   @default(false)
  liveUrl   String?

  post Post?

  @@map("deliverables")
}

model DealStageEvent {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  fromStage  DealStage?
  toStage    DealStage
  note       String?
  changedById String

  createdAt DateTime @default(now())

  @@map("deal_stage_events")
}

model AnalyticsSnapshot {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  date     DateTime
  platform Platform

  impressions    Int   @default(0)
  reach          Int   @default(0)
  engagements    Int   @default(0)
  clicks         Int   @default(0)
  conversions    Int   @default(0)
  engagementRate Float @default(0)
  cpm            Float @default(0)
  cpc            Float @default(0)
  roas           Float @default(0)
  spend          Float @default(0)

  createdAt DateTime @default(now())

  @@unique([campaignId, date, platform])
  @@map("analytics_snapshots")
}

model PlatformStat {
  id        String         @id @default(cuid())
  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  platform Platform
  date     DateTime

  followers   Int
  avgViews    Int?
  avgLikes    Int?
  avgComments Int?
  engRate     Float

  createdAt DateTime @default(now())

  @@unique([creatorId, platform, date])
  @@map("platform_stats")
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

model Lead {
  id      String   @id @default(cuid())
  type    LeadType
  name    String
  company String?
  email   String?
  phone   String?
  notes   String?
  source  String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesDeals SalesDeal[]

  @@map("leads")
}

model SalesDeal {
  id    String         @id @default(cuid())
  title String
  stage SalesDealStage @default(APPOINTMENT_SET)
  value Float?
  notes String?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sales_deals")
}

// ─── Sales ────────────────────────────────────────────────────────────────────

model CallPrep {
  id          String    @id @default(cuid())
  prospect    String
  company     String?
  callType    String
  scheduledAt DateTime?
  sections    Json      @default("[]")
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("call_preps")
}

model Playbook {
  id          String   @id @default(cuid())
  name        String
  description String?
  sections    Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("playbooks")
}

// ─── Posts & Reports ──────────────────────────────────────────────────────────

model Post {
  id            String      @id @default(cuid())
  deliverableId String      @unique
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  campaignId    String
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  liveUrl       String
  thumbnailUrl  String?
  platform      Platform
  postedAt      DateTime
  views         Int         @default(0)
  likes         Int         @default(0)
  comments      Int         @default(0)
  shares        Int         @default(0)
  engagementRate Float      @default(0)
  submittedById String
  submittedBy   User        @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([campaignId])
  @@map("posts")
}

model CampaignReport {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  title         String
  notes         String?
  publishedAt   DateTime @default(now())
  publishedById String
  publishedBy   User     @relation(fields: [publishedById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([campaignId])
  @@map("campaign_reports")
}
